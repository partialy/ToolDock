{
  "name": "tooldock",
  "version": "0.1.0",
  "description": "Desktop toolbox and utility workspace",
  "productName": "ToolDock",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && vite build --config vite.mobile.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "build:runner": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-quick-launch-runner.ps1",
    "dist": "npm run build:runner && npm run build && electron-builder --win nsis",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "bcrypt-pbkdf": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "entities": "^7.0.1",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-image-crop": "^11.1.2",
    "tailwind-merge": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
